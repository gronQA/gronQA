---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import About from '../components/About';
import Services from '../components/Services';
import Portfolio from '../components/Portfolio';
import Pricing from '../components/Pricing';
import Contact from '../components/Contact';
import Footer from '../components/Footer';
---

<Layout 
	title="gronQA | Nowoczesne strony wizytówki" 
	description="Tworzymy nowoczesne i responsywne strony internetowe typu wizytówka dla firm z Zabrza i okolic. Postaw na profesjonalny wizerunek w sieci z gronQA."
	keywords="strony internetowe Zabrze, wizytówki Zabrze, nowoczesne strony www, projektowanie stron internetowych, gronQA, responsywne strony"
>
	<div class="min-h-screen relative overflow-x-hidden">
		{/* Decorative Background Blobs */}
		<div class="glow-blob w-[500px] h-[500px] bg-brand-green top-[-100px] left-[-100px]"></div>
		<div class="glow-blob w-[600px] h-[600px] bg-brand-green/30 bottom-[20%] right-[-200px]"></div>
		<div class="glow-blob w-[400px] h-[400px] bg-white/5 top-[40%] left-[20%]"></div>

		<Navbar client:load />
		<main>
			<Hero client:load />
			<About client:visible />
			<Services client:visible />
			<Portfolio client:visible />
			<Pricing client:load />
			<Contact client:visible />
		</main>
		<Footer client:visible />
	</div>
</Layout>
